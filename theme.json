      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "palette": [
        {
          "slug": "naranja",
          "color": "#ff8700",
          "name": "Naranja"
        },
        {
          "slug": "violeta",
          "color": "#2a0a1e",
          "name": "Violeta"
        },
        {
          "slug": "granate",
          "color": "#2A0A1E",
          "name": "Ciruela Oscura"
        },
        {
          "slug": "amarillo",
          "color": "#ffab00",
          "name": "Amarillo"
        },
        {
          "slug": "naranja-intenso",
          "color": "#FF6B00",
          "name": "Naranja Intenso"
        },
        {
          "slug": "verde",
          "color": "#2f5d3a",
          "name": "Verde bosque"
        },
        {
          "slug": "blanco",
          "color": "#ffffff",
          "name": "Blanco"
        },
        {
          "slug": "gris-piedra",
          "color": "#f4f2ee",
          "name": "Gris piedra"
        },
        {
          "slug": "gris-medio",
          "color": "#e0e0e0",
          "name": "Gris medio"
        },
        {
          "slug": "antracita",
          "color": "#22262b",
          "name": "Antracita"
        },
        {
          "slug": "naranja-oscuro",
          "color": "#b05500",
          "name": "Naranja oscuro (texto)"
        },
        {
          "slug": "naranja-tenue",
          "color": "#fff2e0",
          "name": "Naranja tenue (fondo)"
        },
        {
          "slug": "ambar",
          "color": "#ffab00",
          "name": "Ámbar"
        },
        {
          "slug": "naranja-rojo",
          "color": "#ff500a",
          "name": "Naranja rojo (interacción)"
        },
        {
          "slug": "magenta",
          "color": "#7d0032",
          "name": "Magenta profundo (pie)"
        },
        {
          "slug": "uva",
          "color": "#320028",
          "name": "Uva (superficie oscura)"
        },
        {
          "slug": "carbon",
          "color": "#16181b",
          "name": "Carbón"
        },
        {
          "slug": "gris-texto",
          "color": "#59616a",
          "name": "Gris texto"
        },
        {
          "slug": "gris-borde",
          "color": "#e3ded6",
          "name": "Gris borde"
        },
        {
          "slug": "hueso",
          "color": "#ffffff",
          "name": "Hueso (base)"
        },
        {
          "slug": "arena",
          "color": "#f7f7f7",
          "name": "Arena"
        },
        {
          "slug": "verde-oscuro",
          "color": "#1d3b25",
          "name": "Verde profundo"
        },
        {
          "slug": "verde-claro",
          "color": "#e8f0e6",
          "name": "Verde claro"
        },
        {
          "slug": "tierra",
          "color": "#8d6e63",
          "name": "Tierra"
        },
        {
          "slug": "azul-titular",
          "color": "#1c4587",
          "name": "Azul titular"
        }
      ],
      "gradients": [
        {
          "slug": "sunset-hero",
          "gradient": "linear-gradient(135deg, #ff8700 0%, #ffa94d 50%, #ffc680 100%)",
          "name": "Atardecer Hero"
        },
        {
          "slug": "stats-dark",
          "gradient": "linear-gradient(135deg, #2A0A1E, #0F1115)",
          "name": "Oscuro Stats"
        },
        {
          "slug": "cta-dark",
          "gradient": "linear-gradient(135deg, #2A0A1E, #0F1115)",
          "name": "CTA Oscuro"
        },
        {
          "slug": "naranja-warm",
          "gradient": "linear-gradient(135deg, #ff8700, #FF6B00)",
          "name": "Naranja Cálido"
        },
        {
          "slug": "hero-light",
          "gradient": "linear-gradient(135deg, #ff8700 0%, #ffb347 50%, #ffd699 100%)",
          "name": "Hero Claro"
        },
        {
          "slug": "verde-natural",
          "gradient": "linear-gradient(135deg, #2d5a27, #4a8f3f)",
          "name": "Verde Natural"
        },
        {
          "slug": "foto-oscura",
          "gradient": "linear-gradient(180deg, rgba(10,12,14,0) 38%, rgba(10,12,14,0.78) 100%)",
          "name": "Velo para foto"
        },
        {
          "slug": "naranja-suave",
          "gradient": "linear-gradient(135deg, #fff2e0 0%, #fdfbf8 70%)",
          "name": "Naranja suave"
        },
        {
          "slug": "bosque",
          "gradient": "linear-gradient(160deg, #1d3b25 0%, #2f5d3a 100%)",
          "name": "Bosque"
        }
      ],
      "customDuotone": false,
      "link": true,
      "text": true,
      "background": true,
      "heading": true,
      "button": true
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Lato",
          "fontFamily": "'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "fontFace": []
        },
        {
          "slug": "display",
          "name": "Outfit",
          "fontFamily": "'Outfit', 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "fontFace": []
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Pequeño"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Cuerpo"
        },
        {
          "slug": "large",
          "size": "clamp(1.15rem, 1.5vw, 1.4rem)",
          "name": "Entradilla"
        },
        {
          "slug": "x-large",
          "size": "clamp(1.5rem, 2.4vw, 2.15rem)",
          "name": "Título pequeño"
        },
        {
          "slug": "xx-large",
          "size": "clamp(2rem, 4.2vw, 3.5rem)",
          "name": "Título"
        },
        {
          "slug": "meta",
          "size": "0.8125rem",
          "name": "Metadatos"
        },
        {
          "slug": "display",
          "size": "clamp(2.75rem, 7vw, 5.25rem)",
          "name": "Titular grande"
        }
      ],
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "dropCap": false
    },
    "spacing": {
      "customSpacingSize": true,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "20",
          "size": "1rem",
          "name": "S"
        },
        {
          "slug": "30",
          "size": "clamp(1.5rem, 2.5vw, 2.25rem)",
          "name": "M"
        },
        {
          "slug": "40",
          "size": "clamp(2.5rem, 5vw, 4rem)",
          "name": "L"
        },
        {
          "slug": "50",
          "size": "clamp(3.5rem, 7vw, 6.5rem)",
          "name": "XL"
        },
        {
          "slug": "60",
          "size": "clamp(5rem, 10vw, 9rem)",
          "name": "XXL"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "shadow": "0 4px 24px rgba(255, 135, 0, 0.08)",
          "name": "Tarjeta"
        },
        {
          "slug": "card-hover",
          "shadow": "0 12px 40px rgba(255, 135, 0, 0.14)",
          "name": "Tarjeta Hover"
        },
        {
          "slug": "elevated",
          "shadow": "0 2px 12px rgba(255, 135, 0, 0.06)",
          "name": "Elevada"
        },
        {
          "slug": "tarjeta",
          "name": "Sombra suave",
          "shadow": "0 18px 40px -28px rgba(22, 24, 27, 0.35)"
        },
        {
          "slug": "elevada",
          "name": "Sombra elevada",
          "shadow": "0 30px 60px -32px rgba(22, 24, 27, 0.45)"
        }
      ]
    },
    "custom": {
      "radius": {
        "default": "12px",
        "small": "8px",
        "pill": "50px",
        "imagen": "0.5rem",
        "boton": "999px",
        "bloque": "0.75rem"
      },
      "transition": "0.3s cubic-bezier(0.4, 0, 0.2, 1)",
      "line-height": {
        "ajustada": "1.05",
        "corta": "1.25",
        "normal": "1.6",
        "suelta": "1.75"
      },
      "spacing": {
        "seccion-y": "clamp(3.5rem, 7vw, 6.5rem)",
        "contenido": "46rem",
        "ancho": "85rem"
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|medium",
          "textTransform": "none"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700"
        }
      },
      "core/query-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0.5rem"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|hueso",
      "text": "var:preset|color|carbon"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|30",
        "right": "var:preset|spacing|30"
      },
      "blockGap": "var:preset|spacing|30"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "700",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em",
          "textTransform": "none"
        },
        "color": {
          "text": "var:preset|color|carbon"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "clamp(2.4rem, 5.4vw, 4rem)",
          "fontWeight": "800",
          "lineHeight": "1.02",
          "letterSpacing": "-0.03em"
        },
        "color": {
          "text": "var(--wp--preset--color--naranja)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "clamp(1.9rem, 3.6vw, 3rem)",
          "fontWeight": "700",
          "lineHeight": "1.06",
          "letterSpacing": "-0.025em"
        },
        "color": {
          "text": "var(--wp--preset--color--naranja)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "clamp(1.25rem, 1.7vw, 1.6rem)",
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--naranja)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.125rem",
          "fontWeight": "700",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--naranja)"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|naranja-oscuro"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|carbon"
          },
          "typography": {
            "textDecoration": "underline"
          }
        },
        ":focus": {
          "color": {
            "text": "var(--wp--preset--color--naranja)"
          },
          "typography": {
            "textDecoration": "underline"
          },
          "outline": {
            "color": "var:preset|color|naranja",
            "style": "solid",
            "width": "3px",
            "offset": "2px"
          }
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|medium",
          "textTransform": "none",
          "letterSpacing": "0",
          "textDecoration": "none"
        },
        "color": {
          "background": "var:preset|color|naranja",
          "text": "var:preset|color|carbon"
        },
        "border": {
          "radius": "999px",
          "width": "2px",
          "style": "solid",
          "color": "var:preset|color|naranja"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|carbon",
            "text": "var:preset|color|blanco"
          },
          "border": {
            "color": "var:preset|color|carbon"
          }
        },
        ":focus": {
          "color": {
            "background": "#e67300"
          },
          "border": {
            "color": "var(--wp--preset--color--amarillo)",
            "width": "2px",
            "style": "solid"
          },
          "outline": {
            "color": "var:preset|color|carbon",
            "style": "solid",
            "width": "3px",
            "offset": "2px"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|meta",
          "lineHeight": "1.5"
        },
        "color": {
          "text": "var:preset|color|gris-texto"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "fontSize": "0.95rem"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "none"
              }
            }
          }
        },
        "color": {
          "text": "var:preset|color|carbon"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "800",
          "fontSize": "1.35rem",
          "letterSpacing": "-0.02em",
          "textTransform": "none"
        },
        "color": {
          "text": "#1A1D24"
        },
        "elements": {
          "link": {
            "color": {
              "text": "#1A1D24"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--naranja)"
              },
              "typography": {
                "textDecoration": "none"
              }
            }
          }
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)"
        }
      },
      "core/query-pagination": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|gris-borde"
        },
        "border": {
          "color": "currentColor",
          "width": "1px"
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--naranja)",
          "width": "4px",
          "style": "solid",
          "left": {
            "color": "var:preset|color|naranja",
            "style": "solid",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|30"
          }
        },
        "typography": {
          "fontStyle": "normal",
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "clamp(1.35rem, 2.2vw, 1.9rem)",
          "fontWeight": "500",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var:preset|color|carbon"
        }
      },
      "core/image": {
        "border": {
          "radius": "0.5rem"
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var:preset|font-size|meta",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var:preset|color|gris-texto"
        }
      },
      "core/paragraph": {
        "typography": {
          "lineHeight": "1.7"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0.5rem"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.65"
        },
        "color": {
          "text": "var:preset|color|gris-texto"
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var:preset|font-size|meta",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|gris-texto"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|meta",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase",
          "fontWeight": "700"
        },
        "color": {
          "text": "var:preset|color|naranja-oscuro"
        }
      },
      "core/post-author-name": {
        "typography": {
          "fontSize": "var:preset|font-size|meta",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|gris-texto"
        }
      },
      "core/post-navigation-link": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "700"
        }
      },
      "core/search": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/button": {
        "border": {
          "radius": "999px"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "var:preset|spacing|30"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": {
            "left": "var:preset|spacing|40",
            "top": "var:preset|spacing|30"
          }
        }
      },
      "core/tag-cloud": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/comments": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Cabecera",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pie de página",
      "area": "footer"
    },
    {
      "name": "sidebar",
      "title": "Barra lateral",
      "area": "uncategorized"
    },
    {
      "name": "hero",
      "title": "Hero reutilizable",
      "area": "uncategorized"
    },
    {
      "name": "cta",
      "title": "Llamada a acción",
      "area": "uncategorized"
    },
    {
      "name": "card-actividad",
      "title": "Tarjeta actividad",
      "area": "uncategorized"
    },
    {
      "name": "card-proyecto",
      "title": "Tarjeta proyecto",
      "area": "uncategorized"
    },
    {
      "name": "activity-meta",
      "title": "Metadatos actividad",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "single-actividad",
      "title": "Single Actividad",
      "postTypes": [
        "actividad"
      ]
    },
    {
      "name": "archive-actividad",
      "title": "Archive Actividad",
      "postTypes": [
        "actividad"
      ]
    },
    {
      "name": "page-proyecto",
      "title": "Página de Proyecto",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-actividad",
      "title": "Página de Actividad",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-institucional",
      "title": "Página Institucional",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "Landing Page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
