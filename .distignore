.git/
.github/
.gitignore
.gitattributes
.editorconfig
node_modules/
tests/
vendor/
*.md
*.xml
*.dist
Makefile

# Documentación interna del taller, no se publica
.hermes/

# No se publica
phpunit.xml
phpunit.xml.dist
composer.json
composer.lock
build-dir/
CHANGELOG.md
README.md

# Guiones de desarrollo (auditorias y utilidades), no van al sitio ni al paquete
scripts/

# El guion de la puerta de versión del flujo de desarrollo no viaja al paquete: Theme Check
# lo marca como REQUIRED («Shell script file found. This file must not be in the production
# version of the theme») y tumba el job.
bin/
__pycache__/
*.pyc

# Artefactos de las pruebas de navegador y de PHPUnit: no deben viajar NUNCA.
# `auth.json` es el estado de sesion (cookies de WordPress) y `playwright-report` un
# informe con las trazas. Los dos acabaron servidos por HTTP en sitios reales.
auth.json
storageState.json
playwright-report/
test-results/
.phpunit.result.cache
__pycache__/

# Configuracion de herramientas de analisis estatico: no viaja al sitio ni al paquete.
# Se colaba en el despliegue del tema (medido: 1 fichero en la carga limpia).
phpstan.neon
phpstan.neon.dist
*.neon

# Documentacion interna (los .md ya se excluian, pero el directorio vacio se creaba)
docs/

# El propio fichero de patrones: `rsync --exclude-from` no lo excluye solo, asi que se
# colaba en el sitio y quedaba servido por HTTP (200 en un sitio real). Y los marcadores de git.
.distignore
.gitkeep
.phpcs.xml.dist
.editorconfig
# Política del proyecto: los .htaccess no viajan.
.htaccess
