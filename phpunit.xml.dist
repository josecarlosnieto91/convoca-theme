<?xml version="1.0" encoding="UTF-8"?>
<!-- El .dist es el que usan la puerta local y el job de cobertura. Se añade <source> porque sin
     filtro PHPUnit no procesa la cobertura («No filter is configured»), que es justo lo que dejó
     un job en verde sin medir nada. Se mide el código PHP real del tema: functions.php, parts/ y
     patterns/ (no hay directorio inc/). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         backupGlobals="false"
         colors="true"
         cacheResult="false">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <!-- Solo `functions.php`: es la lógica del tema. `parts/` y `patterns/` son plantillas y `tests/` no es
       producto; medirlos falseaba el porcentaje en los dos sentidos. -->
  <source>
    <include>
      <file>./functions.php</file>
    </include>
  </source>
</phpunit>
